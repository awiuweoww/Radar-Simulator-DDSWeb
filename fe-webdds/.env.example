# --- Dashboard Configuration ---
# The port where the React application will run
SERVICE_PORT=3000
TARGET_PORT=3000

# Service metadata
SERVICE_NAME=radar-webdds
NODE_ENV=development

# --- WebDDS Connection ---
# The WebSocket URL of the Gateway Bridge. 
# Contoh isi .env baru di fe-webdds
VITE_DDS_GATEWAY_REST=http://localhost:8080/dds
VITE_DDS_GATEWAY_WS=ws://localhost:8080/dds